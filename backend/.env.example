# Salin berkas ini menjadi backend/.env lalu isi nilainya SENDIRI di komputer Anda.
# backend/.env sudah diabaikan Git (.gitignore). JANGAN menaruh API key di frontend,
# di dokumentasi, atau di chat. Variabel lingkungan sistem selalu didahulukan.

# --- Teman Mikir (Gemini) ---
# API key dari Google AI Studio (tingkat gratis; jangan aktifkan billing tanpa persetujuan).
# Kosong = Teman Mikir nonaktif; aplikasi tetap berjalan dengan petunjuk H1–H4.
GEMINI_API_KEY=
# Nama model. Periksa model yang tersedia untuk key Anda:
#   .venv\Scripts\python -m app.tools.gemini_check
GEMINI_MODEL=
# Batas panggilan Gemini per hari (seluruh server) dan per sesi aplikasi.
# Bila habis, Teman Mikir tetap menjawab dengan teks cadangan (tanpa Gemini).
TUTOR_DAILY_LIMIT=500
TUTOR_SESSION_LIMIT=40
# Batas waktu satu panggilan Gemini (detik).
GEMINI_TIMEOUT=8

# --- Penelitian ---
# Token header X-Research-Token untuk ringkasan & ekspor CSV. WAJIB diganti.
HH_RESEARCH_TOKEN=ganti-token-ini
