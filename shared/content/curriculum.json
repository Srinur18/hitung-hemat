  "templates": {
    "m1-t1": {
      "process": "employ",
      "items": ["Kaos", "Topi", "Buku tulis", "Pensil warna"],
      "vars": {
        "price": { "range": [10000, 100000, 10000] },
        "pct": { "choices": [1000, 2000, 5000] }
      },
      "text": "Struk belanja: {item} {price|price}, diskon {pct|percent}. Berapa yang harus dibayar?",
      "boxes": { "awal": "price", "diskon": "disc", "akhir": "final" },
      "steps": [
        {
          "id": "s1", "label": "Cari besar diskon", "role": "discount", "input": "rupiah",
          "compute": { "fn": "discountAmount", "args": ["price", "pct"] }, "saveAs": "disc",
          "formula": "Besar diskon = persen diskon × harga awal",
          "worked": "{pct|percent} × {price|price} = {pct|frac} × {price|price} = {disc|discount}",
          "hints": [
            "Yang dicari dulu: besar diskonnya dalam rupiah.",
            "Hitung {pct|percent} dari {price|price}.",
            "{pct|frac} × {price|price} = ___"
          ],
          "mc": ["MC3"]
        },
        {
          "id": "s2", "label": "Hitung harga akhir", "role": "result", "input": "rupiah",
          "compute": { "fn": "subtract", "args": ["price", "disc"] }, "saveAs": "final",
          "formula": "Harga akhir = harga awal − besar diskon",
          "worked": "{price|price} − {disc|discount} = {final|result}",
          "hints": [
            "Diskon membuat harga jadi lebih murah. Apa yang harus dilakukan pada harga awal?",
            "Kurangi harga awal dengan besar diskon.",
            "{price|price} − {disc|discount} = ___"
          ],
          "mc": ["MC1", "MC5"]
        }
      ],
      "sanity": { "left": "final", "op": "<", "right": "price" }
    },
